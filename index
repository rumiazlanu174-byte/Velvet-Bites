/* =========================
   BASIC RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8f3ed;
    color: #2b211c;
    line-height: 1.6;
}


/* =========================
   NAVBAR
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    min-height: 75px;
    padding: 0 7%;
    background: #211915;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: #f4d19b;
    font-size: 25px;
    font-weight: bold;
}

.logo span {
    margin-right: 5px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 35px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 16px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #e3b873;
}


/* =========================
   HERO / HOME
========================= */

.hero {
    min-height: 90vh;

    background:
        linear-gradient(
            rgba(20, 13, 10, 0.68),
            rgba(20, 13, 10, 0.68)
        ),
        url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
    color: white;
}

.hero-content {
    max-width: 750px;
    padding: 30px;
}

.welcome {
    color: #e3b873;
    letter-spacing: 5px;
    font-size: 15px;
    margin-bottom: 10px;
}

.hero h1 {
    font-family: Georgia, serif;
    font-size: 75px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #e3b873;
}

.hero-content > p:not(.welcome) {
    font-size: 18px;
    margin-bottom: 30px;
}


/* =========================
   BUTTON
========================= */

.btn {
    display: inline-block;
    border: none;
    background: #c79a5b;
    color: white;

    padding: 13px 30px;

    border-radius: 4px;
    text-decoration: none;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    background: #a87b3e;
    transform: translateY(-2px);
}


/* =========================
   GENERAL SECTION
========================= */

.section {
    padding: 90px 7%;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title p {
    color: #b07b35;
    font-size: 14px;
    letter-spacing: 4px;
    font-weight: bold;
}

.section-title h2 {
    font-family: Georgia, serif;
    font-size: 42px;
    color: #2b211c;
    margin-top: 5px;
}


/* =========================
   ABOUT
========================= */

.about {
    background: #fffaf4;
}

.about-content {
    max-width: 1050px;
    margin: auto;

    display: flex;
    gap: 50px;
    align-items: center;
}

.about-text {
    flex: 1;
}

.about-text h3 {
    font-family: Georgia, serif;
    font-size: 30px;
    margin-bottom: 15px;
}

.about-text p {
    margin-bottom: 15px;
    color: #665850;
}

.about-box {
    flex: 1;
    min-height: 230px;

    background: #211915;
    color: white;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    border-radius: 8px;
    padding: 30px;
}

.about-box h3 {
    color: #e3b873;
    font-family: Georgia, serif;
    font-size: 25px;
    margin-bottom: 10px;
}


/* =========================
   MENU
========================= */

.menu {
    background: #f8f3ed;
}

.menu-container {
    max-width: 1150px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.food-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;

    box-shadow: 0 8px 25px rgba(50, 35, 25, 0.12);

    transition: 0.3s;
}

.food-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(50, 35, 25, 0.18);
}

.food-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
}

.food-info {
    padding: 22px;
}

.food-info h3 {
    font-family: Georgia, serif;
    font-size: 21px;
    margin-bottom: 8px;
}

.food-info p {
    color: #766960;
    font-size: 14px;
    margin-bottom: 15px;
}

.food-info span {
    color: #a36d2d;
    font-size: 18px;
    font-weight: bold;
}


/* =========================
   BOOKING
========================= */

.booking {
    background: #fffaf4;
}

.form-container {
    max-width: 650px;
    margin: auto;

    background: white;
    padding: 40px;

    border-radius: 8px;

    box-shadow: 0 8px 30px rgba(50, 35, 25, 0.12);
}

.input-group {
    margin-bottom: 20px;
}

.input-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
}

.input-group input,
.input-group textarea {
    width: 100%;

    padding: 13px 15px;

    border: 1px solid #d8cec4;
    border-radius: 4px;

    outline: none;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
}

.input-group input:focus,
.input-group textarea:focus {
    border-color: #c79a5b;
}

.input-group textarea {
    resize: vertical;
}

.form-container .btn {
    width: 100%;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #211915;
    color: white;
}

.footer-content {
    max-width: 1150px;
    margin: auto;

    padding: 55px 7%;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
}

.footer-box h3 {
    color: #e3b873;
    font-family: Georgia, serif;
    font-size: 21px;
    margin-bottom: 15px;
}

.footer-box p {
    color: #d3c9c1;
    font-size: 14px;
    margin-bottom: 7px;
}

.copyright {
    border-top: 1px solid #4a3b33;
    text-align: center;
    padding: 20px;
}

.copyright p {
    color: #bdb1a9;
    font-size: 13px;
}


/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 850px) {

    .navbar {
        padding: 20px 5%;
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 55px;
    }

    .about-content {
        flex-direction: column;
    }

    .menu-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }
}


@media (max-width: 550px) {

    .nav-links {
        gap: 10px;
    }

    .nav-links a {
        font-size: 14px;
    }

    .hero {
        min-height: 80vh;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-content > p:not(.welcome) {
        font-size: 15px;
    }

    .section {
        padding: 65px 5%;
    }

    .section-title h2 {
        font-size: 34px;
    }

    .menu-container {
        grid-template-columns: 1fr;
    }

    .form-container {
        padding: 25px;
    }
}
