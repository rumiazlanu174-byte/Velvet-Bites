        </div>

    </section>


    <!-- ================= BOOK NOW ================= -->
    <section id="book" class="booking section">

        <div class="section-title">
            <p>RESERVE YOUR TABLE</p>
            <h2>Book Now</h2>
        </div>

        <div class="form-container">

            <form>

                <div class="input-group">
                    <label for="name">Name</label>
                    <input
                        type="text"
                        id="name"
                        placeholder="Enter your name"
                        required>
                </div>


                <div class="input-group">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        required>
                </div>


                <div class="input-group">
                    <label for="phone">Contact Number</label>
                    <input
                        type="tel"
                        id="phone"
                        placeholder="Enter your contact number"
                        required>
                </div>


                <div class="input-group">
                    <label for="message">Comments / Message</label>
                    <textarea
                        id="message"
                        rows="5"
                        placeholder="Write your message here..."></textarea>
                </div>


                <button type="submit" class="btn">
                    Book Now
                </button>

            </form>

        </div>

    </section>


    <!-- ================= FOOTER ================= -->
    <footer>

        <div class="footer-content">

            <div class="footer-box">
                <h3>🍴 Velvet Bites</h3>
                <p>
                    Delicious flavors, unforgettable moments.
                </p>
            </div>


            <div class="footer-box">
                <h3>Contact</h3>
                <p>📍 Karachi, Pakistan</p>
                <p>📞 +92 300 1234567</p>
                <p>✉️ info@velvetbites.com</p>
            </div>


            <div class="footer-box">
                <h3>Opening Hours</h3>
                <p>Monday - Thursday: 12 PM - 11 PM</p>
                <p>Friday - Sunday: 12 PM - 12 AM</p>
            </div>

