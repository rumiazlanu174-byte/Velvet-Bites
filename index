                <div class="food-info">
                    <h3>Classic Velvet Burger</h3>
                    <p>
                        Juicy beef patty, fresh vegetables and melted cheese.
                    </p>
                    <span>Rs. 650</span>
                </div>
            </div>


            <!-- Food 2 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=800&q=80"
                    alt="Chicken Pizza">

                <div class="food-info">
                    <h3>Chicken Fajita Pizza</h3>
                    <p>
                        Soft crust topped with chicken, vegetables and cheese.
                    </p>
                    <span>Rs. 950</span>
                </div>
            </div>


            <!-- Food 3 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1555949258-eb67b1ef0ceb?auto=format&fit=crop&w=800&q=80"
                    alt="Alfredo Pasta">

                <div class="food-info">
                    <h3>Creamy Alfredo Pasta</h3>
                    <p>
                        Creamy pasta prepared with chicken and parmesan.
                    </p>
                    <span>Rs. 850</span>
                </div>
            </div>


            <!-- Food 4 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80"
                    alt="Chicken Wings">

                <div class="food-info">
                    <h3>Crispy Chicken Wings</h3>
                    <p>
                        Crispy golden wings served with our special sauce.
                    </p>
                    <span>Rs. 600</span>
                </div>
            </div>


            <!-- Food 5 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=800&q=80"
                    alt="Loaded Fries">

                <div class="food-info">
                    <h3>Loaded Cheese Fries</h3>
                    <p>
                        Crispy fries loaded with cheese and special toppings.
                    </p>
                    <span>Rs. 550</span>
                </div>
            </div>


            <!-- Food 6 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=800&q=80"
                    alt="Chocolate Cake">

                <div class="food-info">
                    <h3>Chocolate Lava Cake</h3>
                    <p>
                        Warm chocolate cake with a rich melted center.
