   <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Bites | Restaurant</title>

    <!-- CSS File -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar">

            <div class="logo">
                <span>🍴</span> Velvet Bites
            </div>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About Us</a></li>
                <li><a href="#menu">Menu Gallery</a></li>
                <li><a href="#book">Book Now</a></li>
            </ul>

        </nav>
    </header>


    <!-- ================= HOME ================= -->
    <section id="home" class="hero">

        <div class="hero-content">
            <p class="welcome">WELCOME TO</p>

            <h1>Velvet <span>Bites</span></h1>

            <p>
                Delicious flavors, unforgettable moments.
                Experience fresh food in a warm and elegant atmosphere.
            </p>

            <a href="#menu" class="btn">Explore Menu</a>
        </div>

    </section>


    <!-- ================= ABOUT ================= -->
    <section id="about" class="about section">

        <div class="section-title">
            <p>OUR STORY</p>
            <h2>About Us</h2>
        </div>

        <div class="about-content">

            <div class="about-text">
                <h3>A Taste Worth Savoring</h3>

                <p>
                    At Velvet Bites, we believe every meal should be
                    a memorable experience. Our kitchen brings together
                    fresh ingredients, delicious flavors and creative
                    recipes.
                </p>

                <p>
                    Whether you are enjoying a casual meal with friends
                    or celebrating a special moment, we are here to
                    make every bite special.
                </p>
            </div>

            <div class="about-box">
                <h3>Fresh • Delicious • Elegant</h3>
                <p>
                    Quality food served with love.
                </p>
            </div>

        </div>

    </section>


    <!-- ================= MENU ================= -->
    <section id="menu" class="menu section">

        <div class="section-title">
            <p>WHAT WE SERVE</p>
            <h2>Menu Gallery</h2>
        </div>

        <div class="menu-container">

            <!-- Food 1 -->
            <div class="food-card">
                <img
                    src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80"
